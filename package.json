{
  "name": "dsh-server-panel",
  "version": "0.1.0",
  "description": "DSH Web 插件：在 WebUI 侧栏加一个整页服务器管理面板（资源概览 / systemd 服务与日志 / 文件管理），带按需 sudo 解锁通道。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/run.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "server",
    "systemd",
    "panel"
  ],
  "license": "MIT",
  "author": "lsl1931",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsl1931/dsh-server-panel.git"
  },
  "homepage": "https://github.com/lsl1931/dsh-server-panel#readme",
  "bugs": {
    "url": "https://github.com/lsl1931/dsh-server-panel/issues"
  }
}
